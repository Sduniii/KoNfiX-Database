# ==============================================================================
# KoNfiX-Database & Catalog - Umgebungsvariablen (.env)
# ==============================================================================
# Kopiere diese Vorlage in eine Datei namens '.env' in diesem Verzeichnis:
#   cp .env.example .env
#
# WICHTIG:
# - Die Datei '.env' wird von Git ignoriert (.gitignore) und NIEMALS bei 'git pull' überschrieben.
# - Werte in '.env' haben ABSOLUTEN VORRANG vor den Standardwerten in app/config.py.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anwendung, Host & Schemas
# ------------------------------------------------------------------------------
# Name der Anwendung in Weboberfläche, OpenAPI und Swagger
APP_NAME=KoNfiX-Database

# Semantische Version
APP_VERSION=1.0.0

# Kurzbeschreibung für die API-Dokumentation
APP_DESCRIPTION="Open REST Online Database & Catalog for KNX devices (.knxprod)"

# Öffentliche Basis-URL der Catalog-Instanz (ohne abschließenden Schrägstrich)
# Beispiele:
#   PUBLIC_BASE_URL=https://db.konfix.sduni.de   (Produktion)
#   PUBLIC_BASE_URL=http://localhost:8000        (Lokale Entwicklung)
PUBLIC_BASE_URL=https://db.konfix.sduni.de

# Offizielle URL zum validierenden JSON-Schema (v1)
# Beispiele:
#   SCHEMA_URL=https://db.konfix.sduni.de/schemas/konfix-device-v1.json
SCHEMA_URL=https://db.konfix.sduni.de/schemas/konfix-device-v1.json

# ------------------------------------------------------------------------------
# 2. Sicherheit & Administrator-Schutz (ADMIN_KEY)
# ------------------------------------------------------------------------------
# Geheimer Admin-Schlüssel zum Schutz administrativer und destruktiver Aktionen.
#
# SCHUTZ-VERHALTEN:
# - Sobald hier ein Schlüssel eingetragen ist:
#   * DELETE /api/v1/devices/{order_number} erfordert zwingend den Admin-Key (HTTP 401 bei Fehlen).
#   * POST /api/v1/devices/batch-delete erfordert zwingend den Admin-Key.
#   * PATCH /api/v1/devices/{order_number} ohne gerätespezifischen edit_code erfordert den Admin-Key.
#   * Der Key kann im Header 'X-API-Key: <key>' oder als 'Authorization: Bearer <key>' übermittelt werden.
# - Wenn leer (Standard):
#   * Der Katalog befindet sich im offenen Entwicklungsmodus (Open Mode).
#
# Beispiele:
#   ADMIN_KEY=sicheres-admin-passwort-123456
#   ADMIN_KEY=
ADMIN_KEY=

# Abwärtskompatibler Alias für ADMIN_KEY (wird beachtet, falls ADMIN_KEY leer ist):
# API_KEY=mein-admin-key

# Regelt, ob jeder Besucher neue Geräte hochladen darf:
# - true:  Öffentlicher Upload erlaubt. Jeder Uploader erhält einen eigenen edit_code.
# - false: Privater Modus. Neue Uploads erfordern zwingend den ADMIN_KEY!
# Beispiele:
#   ALLOW_PUBLIC_UPLOAD=true
#   ALLOW_PUBLIC_UPLOAD=false
ALLOW_PUBLIC_UPLOAD=true

# Automatisches Anlegen von Demo-Geräten beim allerersten Start (nur bei leerer DB):
# - true:  Erstellt automatisch Beispiel-Aktoren (ideal für schnelles Testen).
# - false: Saubere, leere Datenbank (Standard für Produktion).
AUTO_SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 3. Datenbank-Verbindung (DATABASE_URL)
# ------------------------------------------------------------------------------
# Standard: Lokale SQLite-Datei im Unterordner data/
# DATABASE_URL=sqlite:///./data/konfix_database.db
#
# Absoluter Pfad für Linux / Docker / Render.com Persistent Disk:
# DATABASE_URL=sqlite:////var/data/konfix_database.db
#
# Für PostgreSQL in Produktion:
# DATABASE_URL=postgresql://konfix_user:geheimes_passwort@localhost:5432/konfix_db
#
# Für MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://konfix_user:passwort@127.0.0.1:3306/konfix_db

# ------------------------------------------------------------------------------
# 4. Speicherverzeichnis für .knxprod & .yaml Dateien (STORAGE_DIR)
# ------------------------------------------------------------------------------
# Standard: Relativer Ordner 'catalog_files' im Projektverzeichnis
# STORAGE_DIR=./catalog_files
#
# Für Docker / Render.com Persistent Volume:
# STORAGE_DIR=/var/data/catalog_files

# ------------------------------------------------------------------------------
# 5. Upload-Limits & DoS-Schutz (in Bytes bzw. Anzahlen)
# ------------------------------------------------------------------------------
# Maximaler Upload in Bytes (Standard: 50 MB = 52.428.800 Bytes)
# Beispiele:
#   MAX_UPLOAD_SIZE_BYTES=52428800    # 50 MB
#   MAX_UPLOAD_SIZE_BYTES=104857600   # 100 MB
MAX_UPLOAD_SIZE_BYTES=52428800

# Maximale entpackte Gesamtgröße eines ZIP-Archivs (Schutz vor ZIP-Bomben)
# Standard: 200 MB = 209.715.200 Bytes
MAX_ZIP_EXTRACTED_BYTES=209715200

# Maximale Anzahl an Dateien innerhalb eines hochgeladenen Archivs
MAX_ZIP_FILES=500

# Maximale Größe für eine einzelne XML-Datei im Archiv (Schutz vor XML-Entity-Expansion)
MAX_XML_PARSE_BYTES=209715200

# ------------------------------------------------------------------------------
# 6. CORS & Netzwerk
# ------------------------------------------------------------------------------
# Erlaubte Origins für Web-Clients (JSON-Array-Syntax):
# Beispiele:
#   ALLOWED_ORIGINS=["*"]
#   ALLOWED_ORIGINS=["https://db.konfix.sduni.de", "https://konfix.sduni.de", "http://localhost:8000"]
ALLOWED_ORIGINS=["*"]

# CORS-Credentials erlauben (Darf gemäß CORS-Spezifikation nicht true sein, wenn ALLOWED_ORIGINS=["*"]):
CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------------------------
# 7. Rechtliche Angaben & Weiterleitungen
# ------------------------------------------------------------------------------
# Kontaktadresse für Notice-and-Takedown-Verfahren nach § 23 MarkenG
LEGAL_CONTACT_EMAIL=legal@konfix.sduni.de

# Wenn true, leitet der Download-Endpunkt bei hinterlegter Hersteller-Quelle per HTTP 302 weiter:
#   PREFER_SOURCE_REDIRECT=false   (Datei direkt vom Katalog-Server ausliefern)
#   PREFER_SOURCE_REDIRECT=true    (HTTP 302 Redirect zum offiziellen Hersteller-Download)
PREFER_SOURCE_REDIRECT=false

# Optionale kommagetrennte Passwörter zur Entschlüsselung proprietärer Legacy-Dateien (.vd5):
# KNX_LEGACY_PASSWORDS=herstellerPasswort1,geheimerSchluessel2
KNX_LEGACY_PASSWORDS=
