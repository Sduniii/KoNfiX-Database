# ==============================================================================
# KoNfiX-Database & Catalog - Umgebungsvariablen (.env)
# ==============================================================================
# Kopiere diese Vorlage nach '.env' für deine lokalen oder produktiven Einstellungen:
#   cp .env.example .env
#
# WICHTIG: Die Datei '.env' wird von Git ignoriert und niemals bei 'git pull'
# überschrieben. Hier eingetragene Werte überschreiben die Standardwerte in app/config.py.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anwendung & Allgemeines
# ------------------------------------------------------------------------------
APP_NAME=KoNfiX-Database
APP_VERSION=1.0.0
APP_DESCRIPTION="Open REST Online Database & Catalog for KNX devices (.knxprod)"

# ------------------------------------------------------------------------------
# 2. Sicherheit, Admin-Zugang & Berechtigungen
# ------------------------------------------------------------------------------
# Optionaler geheimer Admin-Key für administrative Aktionen (z. B. Takedowns, Löschen).
# Wenn leer, befindet sich der Katalog im offenen Modus.
ADMIN_KEY=
# API_KEY=  # Fallback-Alias für ADMIN_KEY

# Erlaubt öffentlichen Dateiupload (Standard: true).
# Bei false ist ein Admin-Key für alle Uploads zwingend erforderlich.
ALLOW_PUBLIC_UPLOAD=true

# Automatisches Anlegen von Beispieldaten beim Starten (Standard: false)
AUTO_SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 3. Datenbank-Verbindung
# ------------------------------------------------------------------------------
# Standard: SQLite-Datenbank im Ordner data/
# DATABASE_URL=sqlite:///./data/konfix_database.db
#
# Für PostgreSQL in Produktion (z. B.):
# DATABASE_URL=postgresql://konfix_user:geheimes_passwort@localhost:5432/konfix_db

# ------------------------------------------------------------------------------
# 4. Speicherverzeichnis für .knxprod & .yaml Dateien
# ------------------------------------------------------------------------------
# Standard: Ordner 'catalog_files' im Projektverzeichnis
# STORAGE_DIR=./catalog_files

# ------------------------------------------------------------------------------
# 5. Upload-Limits & DoS-Schutz (in Bytes bzw. Anzahlen)
# ------------------------------------------------------------------------------
# 50 MB maximaler Upload
MAX_UPLOAD_SIZE_BYTES=52428800

# 200 MB maximal entpackte ZIP-Größe
MAX_ZIP_EXTRACTED_BYTES=209715200

# Maximal 500 Dateien pro ZIP-Archiv
MAX_ZIP_FILES=500

# 20 MB maximale Größe für eine einzelne XML-Datei im Archiv
MAX_XML_PARSE_BYTES=209715200

# ------------------------------------------------------------------------------
# 6. CORS & Netzwerk
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------------------------
# 7. Rechtliche Angaben & Hersteller-Weiterleitung
# ------------------------------------------------------------------------------
LEGAL_CONTACT_EMAIL=legal@konfix.sduni.de

# Wenn true, leitet der Download-Endpunkt bei hinterlegter Hersteller-Quelle per HTTP 302 weiter
PREFER_SOURCE_REDIRECT=false

# Optionale kommagetrennte Passwörter zur Entschlüsselung von Legacy-Dateien (.vd5)
KNX_LEGACY_PASSWORDS=
